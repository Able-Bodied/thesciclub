# Signs the store app (lane release_build) and uploads it to TestFlight
# (release_upload). Run by .github/workflows/ios-release.yml, which checks
# the archive for Facebook's SDK between the two and supplies everything
# below as environment variables; nothing is written to disk but the profile
# and build/.
#
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64  the App Store Connect API key
#   APP_VERSION                                    marketing version, 1.2.3
#   GOOGLE_IOS_CLIENT_ID                           Google sign-in's iOS client (public)
#   WHATS_NEW_FILE                                 optional "What to Test" text
#
# The Apple Distribution certificate is already in a keychain on the search
# list (the workflow's job); this finds the App Store profile that matches it.

require "plist"
require "shellwords"

APP_ID = "com.thesciclub.app"
ROOT = File.expand_path("..", FastlaneCore::FastlaneFolder.path)
ENTITLEMENTS = File.join(ROOT, "App", "App.entitlements")
# The workflow's Facebook check reads the archive; upload sends the .ipa.
ARCHIVE = File.join(ROOT, "build", "TheSciClub.xcarchive")
IPA = File.join(ROOT, "build", "TheSciClub.ipa")

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
    is_key_content_base64: true
  )
end

# Google's sign-in returns to the app on its iOS client ID, reversed.
def google_reversed_client_id
  id = ENV.fetch("GOOGLE_IOS_CLIENT_ID", "").strip
  match = /\A([0-9]+-[a-z0-9]+)\.apps\.googleusercontent\.com\z/.match(id)
  UI.user_error!("GOOGLE_IOS_CLIENT_ID is not an iOS client ID: #{id.inspect}") unless match
  "com.googleusercontent.apps.#{match[1]}"
end

# The capabilities App.entitlements asks for that the profile lacks. A profile
# made before the App ID gained one is left without it, and the signed app
# would be refused.
def missing_entitlements(profile_path)
  wanted = Plist.parse_xml(File.read(ENTITLEMENTS)).keys
  decoded = sh("security cms -D -i #{profile_path.shellescape}", log: false)
  granted = Plist.parse_xml(decoded).fetch("Entitlements", {}).keys
  wanted - granted
end

default_platform(:ios)

platform :ios do
  desc "Sign and archive a TestFlight build, into build/"
  lane :release_build do
    key = asc_api_key

    # One past the newest upload of any version, so numbers only go up.
    build_number = latest_testflight_build_number(
      api_key: key,
      app_identifier: APP_ID,
      initial_build_number: 0
    ) + 1
    version = ENV.fetch("APP_VERSION")
    UI.important("Building #{version} (#{build_number})")

    reversed_client_id = google_reversed_client_id

    # Finds the App Store profile for the installed certificate, or makes one,
    # and makes a new one if it lacks Sign in with Apple, Associated Domains
    # or Push Notifications (aps-environment).
    get_provisioning_profile(api_key: key, app_identifier: APP_ID)
    missing = missing_entitlements(lane_context[SharedValues::SIGH_PROFILE_PATH])
    unless missing.empty?
      UI.important("The profile lacks #{missing.join(", ")}: making a new one")
      get_provisioning_profile(api_key: key, app_identifier: APP_ID, force: true)
      missing = missing_entitlements(lane_context[SharedValues::SIGH_PROFILE_PATH])
      UI.user_error!(
        "The App ID #{APP_ID} does not have #{missing.join(", ")}. Turn them on in " \
        "Certificates, Identifiers & Profiles, then run this again."
      ) unless missing.empty?
    end
    profile_name = lane_context[SharedValues::SIGH_NAME]
    team_id = sh(
      "security cms -D -i #{lane_context[SharedValues::SIGH_PROFILE_PATH].shellescape} " \
      "| plutil -extract TeamIdentifier.0 raw -o - -",
      log: false
    ).strip

    # Manual signing on the app target only; Xcode's own signing is not used.
    update_code_signing_settings(
      path: File.join(ROOT, "App.xcodeproj"),
      targets: ["App"],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name
    )

    build_app(
      project: File.join(ROOT, "App.xcodeproj"),
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        signingCertificate: "Apple Distribution",
        provisioningProfiles: { APP_ID => profile_name }
      },
      xcargs: "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number} " \
              "GOOGLE_REVERSED_CLIENT_ID=#{reversed_client_id}",
      skip_profile_detection: true,
      archive_path: ARCHIVE,
      output_directory: File.join(ROOT, "build"),
      output_name: "TheSciClub"
    )
  end

  desc "Upload release_build's .ipa to TestFlight"
  lane :release_upload do
    UI.user_error!("No #{IPA}: run the release_build lane first") unless File.exist?(IPA)

    # With a changelog, the upload waits only until the build appears in App
    # Store Connect to set "What to Test"; it never waits for processing.
    notes_file = ENV["WHATS_NEW_FILE"].to_s
    notes = File.exist?(notes_file) ? File.read(notes_file).strip : ""
    upload_to_testflight(
      api_key: asc_api_key,
      app_identifier: APP_ID,
      ipa: IPA,
      changelog: notes.empty? ? nil : notes,
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
