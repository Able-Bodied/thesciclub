# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*

node_modules
dist
# The store app's web build (pnpm build:native), copied into ios/ and android/ by cap sync.
dist-native
dist-ssr
*.local

# Env — .env.local carries the Supabase anon key and the service_role key.
# The service_role key bypasses RLS entirely; it must never be committed and
# never reach the browser bundle.
.env
.env.*
!.env.example

# Apple keys and signing files (push key, App Store Connect key, certificates).
# They live in the owner's password manager and in secrets, never in the repo.
*.p8
*.p12
*.mobileprovision

# Test / coverage
coverage
*.tsbuildinfo

# Editor
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.sw?

# Supabase CLI local state
supabase/.temp/
supabase/.branches/
screenshots/
.logo-candidates/
logos-from-you/
# The owner's brand master files (2026-09-28). What the app uses is copied into
# public/ — fonts, the badge, the compact lockup and the icons.
sci-club-logo/

# Netlify CLI — `netlify link` keeps the site id and local state here.
.netlify

# The owner's own audit notes, kept out of the repository (2026-10-07).
AUDIT.md
