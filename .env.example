# Copy to .env.local and fill in from your Supabase project: Settings > API.
# .env.local is gitignored. Never commit real keys.

# Browser-visible. Safe to ship — RLS is what protects the data, not this key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only, for jobs/event-ingest. BYPASSES RLS. Never prefix a secret
# with VITE_ — anything so prefixed is inlined into the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (VAPID). The public half is browser-visible and is the switch that
# shows the Notifications row on Me — leave it unset until the sender is live.
# The private half is the sender's: a function secret, never VITE_-prefixed.
# See HANDOFF.md, "Next up: notifications on an iPhone".
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
