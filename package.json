{
  "name": "thesciclub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.1+sha512.2e81e399d73fe8390dab25e06aa788ab7a5908248d2f5a370f82b481147a6a7a367bf8048f9a6fdb6460f21a66f0542dedb8b94ca2c8723596741920b1656d4c",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-legal.mjs",
    "build:native": "tsc -b && vite build --mode native",
    "native:sync": "pnpm build:native && cap sync",
    "native:assets": "pnpm dlx --allow-build=sharp @capacitor/assets@3.0.5 generate --ios --android --iconBackgroundColor '#102A4C' --iconBackgroundColorDark '#102A4C' --splashBackgroundColor '#102A4C' --splashBackgroundColorDark '#102A4C'",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome ci . && eslint . --max-warnings 0 && tsc -b --noEmit",
    "fix": "eslint . --fix && biome check --write .",
    "shoot": "LD_LIBRARY_PATH=\"$HOME/.cache/thesciclub-browser-libs/root/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH\" node scripts/shoot.mjs",
    "realtime-check": "LD_LIBRARY_PATH=\"$HOME/.cache/thesciclub-browser-libs/root/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH\" node scripts/realtime-check.mjs",
    "demo-member": "node scripts/demo-member.mjs",
    "backfill-series": "node scripts/backfill-series.mjs",
    "logos": "LD_LIBRARY_PATH=\"$HOME/.cache/thesciclub-browser-libs/root/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH\" node scripts/logos.mjs",
    "reprocess-photos": "LD_LIBRARY_PATH=\"$HOME/.cache/thesciclub-browser-libs/root/usr/lib/x86_64-linux-gnu:$LD_LIBRARY_PATH\" node scripts/reprocess-photos.mjs",
    "check-photo-policy": "node scripts/check-photo-policy.mjs",
    "check-chat-photo-policy": "node scripts/check-chat-photo-policy.mjs",
    "map-tiles": "node scripts/map-tiles.mjs",
    "tiles-worker:deploy": "pnpm dlx --allow-build=esbuild --allow-build=workerd wrangler@4.149.0 deploy --config tiles-worker/wrangler.toml"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/text-zoom": "8.0.1",
    "@capawesome/capacitor-badge": "8.0.4",
    "@capgo/capacitor-social-login": "8.5.13",
    "@protomaps/basemaps": "5.7.2",
    "@supabase/supabase-js": "^2.112.3",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "maplibre-gl": "6.14.0",
    "pmtiles": "4.5.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "fake-indexeddb": "6.2.5",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "netlify-cli": "^27.10.0",
    "playwright": "^1.63.0",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-core": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1"
  }
}
